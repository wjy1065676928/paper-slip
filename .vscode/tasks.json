{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build & Run Release",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "cd ${workspaceFolder} && .\\gradlew.bat assembleRelease"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        },
        {
            "label": "Build & Run Debug",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "cd ${workspaceFolder} && .\\gradlew.bat assembleDebug"
            ],
            "group": "build"
        },
        {
            "label": "Install & Run (需连接设备)",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "cd ${workspaceFolder} && .\\gradlew.bat installRelease && adb shell am start -n io.github.wjy.meditate/.MainActivity"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "连接设备 (无线调试)",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "echo 请输入手机的 IP 地址和端口 (格式: 192.168.1.100:5555) && adb connect 192.168.1.100:5555"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "查看连接的设备",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "adb devices"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "断开无线连接",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "adb disconnect"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}